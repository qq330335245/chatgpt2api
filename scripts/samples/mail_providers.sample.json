{
  "providers": [
    {
      "provider_ref": "inbucket1",
      "type": "inbucket",
      "enable": true,
      "label": "Oracle Inbucket",
      "api_base": "https://mailin.konsin.de5.net",
      "api_token": "YOUR_INGEST_TOKEN",
      "mailbox_naming": "full",
      "random_subdomain": false,
      "domain": [
        "konsin.de5.net"
      ]
    },
    {
      "provider_ref": "cf1",
      "type": "cloudflare_temp_email",
      "enable": false,
      "label": "CF Temp Mail",
      "api_base": "https://your-worker.example.com",
      "admin_password": "YOUR_ADMIN_PASSWORD",
      "domain": [
        "your-domain.com"
      ],
      "inbox_address": "catch@your-domain.com"
    },
    {
      "provider_ref": "m2925",
      "type": "mail_2925",
      "enable": true,
      "label": "2925",
      "main_email": "name@2925.com",
      "main_password": "YOUR_PASSWORD",
      "imap_host": "imap.2925.com",
      "imap_port": 993
    },
    {
      "provider_ref": "icloud1",
      "type": "icloud",
      "enable": true,
      "label": "iCloud HME + Inbucket forward",
      "connection_mode": "temp_mail",
      "icloud_cookies": "X-APPLE-WEBAUTH-USER=...; X-APPLE-WEBAUTH-TOKEN=...; X-APPLE-DS-WEB-SESSION-TOKEN=...",
      "temp_mail_type": "inbucket",
      "temp_mail_provider_ref": "inbucket1",
      "temp_mail_target_email": "apple2@konsin.de5.net",
      "platform": "chatgpt",
      "icloud_alias_label": "chatgpt",
      "reuse_aliases": true,
      "create_when_exhausted": true,
      "cloud_mark": true,
      "coordination_mode": "local_fast",
      "async_mark": true,
      "background_replenish": true,
      "low_watermark": 5,
      "high_watermark": 20,
      "inventory_path": "icloud_alias_inventory.db"
    },
    {
      "provider_ref": "icloud_imap",
      "type": "icloud",
      "enable": false,
      "label": "iCloud IMAP shared mailbox",
      "connection_mode": "imap",
      "shared_email": "you@icloud.com",
      "shared_password": "app-specific-password"
    }
  ],
  "wait_timeout": 120,
  "wait_interval": 2,
  "request_timeout": 30,
  "api_use_register_proxy": true
}
